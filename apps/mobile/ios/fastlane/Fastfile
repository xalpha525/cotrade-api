default_platform(:ios)

platform :ios do
  desc "Push CoTrade standalone app to TestFlight"
  lane :deploy_testflight do
    # 1. Authenticate with App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: "5JQ922VJHD",
      issuer_id: "35f52721-fd60-4398-a70f-13a4ae870a55",
      key_content: File.read(File.expand_path("AuthKey_5JQ922VJHD.p8", __dir__)),
      is_key_content_base64: false,
      in_house: false
    )

    # 2. Ensure AppStore Provisioning Profile exists for com.copytrading.app
    UI.message("Fetching/Creating App Store Provisioning Profile for com.copytrading.app...")
    profile_name = "com.copytrading.app AppStore"
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.copytrading.app",
      team_id: "JF8U2T952N",
      force: true,
      filename: "CoTrade_AppStore.mobileprovision"
    )

    # 3. Build & Export Release IPA
    UI.message("Building CoTrade standalone Release IPA...")
    gym(
      workspace: "CopyTrading.xcworkspace",
      scheme: "CopyTrading",
      clean: true,
      configuration: "Release",
      output_directory: "build/ipa",
      output_name: "CoTrade.ipa",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        provisioningProfiles: {
          "com.copytrading.app" => profile_name
        },
        signingStyle: "manual",
        signingCertificate: "Apple Distribution"
      },
      xcargs: "DEVELOPMENT_TEAM=JF8U2T952N CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'"
    )

    # 4. Upload to TestFlight
    UI.message("Uploading CoTrade IPA to TestFlight (App ID: 6794301681)...")
    ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH] || File.expand_path("../build/ipa/CoTrade.ipa", __dir__)

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.copytrading.app",
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )

    UI.success("🎉 CoTrade (com.copytrading.app) successfully built and uploaded to TestFlight!")
  end
end
