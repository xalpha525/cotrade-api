########################################
# APP
########################################

APP_ENV=local
APP_NAME=CopyTrading
APP_VERSION=1.0.0
NODE_ENV=development

########################################
# SERVER
########################################

API_URL=http://localhost:3000
PORT=3000

########################################
# SECURITY
########################################

JWT_SECRET=your_jwt_secret_here
MASTER_ENCRYPTION_KEY=your_master_encryption_key_here

########################################
# CORS
########################################

CORS_ORIGINS=http://localhost:8081,http://localhost:3000

########################################
# RATE LIMITING
########################################

RATE_LIMIT=100
RATE_LIMIT_WINDOW=60

########################################
# DATABASE
########################################

DATABASE_POOL_SIZE=20
DATABASE_TIMEOUT=30000

########################################
# NEON DATABASE
########################################

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

########################################
# UPSTASH REDIS
########################################

UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io

########################################
# SOLANA (HELIUS)
########################################

HELIUS_API_KEY=your_helius_api_key
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=your_helius_api_key

########################################
# ROBINHOOD CHAIN
########################################

ROBINHOOD_API_KEY=your_robinhood_api_key
ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/your_alchemy_api_key
ROBINHOOD_WS_URL=wss://robinhood-mainnet.g.alchemy.com/v2/your_alchemy_api_key

########################################
# PRIVY
########################################

PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

########################################
# BLOCKCHAIN
########################################

EVM_NETWORK=robinhood-mainnet
SOLANA_NETWORK=mainnet

########################################
# TRADING ENGINE
########################################

DEFAULT_PRIORITY_FEE=medium
MAX_COPY_TRADES=20
MAX_SLIPPAGE_BPS=100
WS_HEARTBEAT_INTERVAL=30000
WS_RECONNECT_DELAY=5000

########################################
# NOTIFICATIONS
########################################

FCM_PROJECT_ID=your_fcm_project_id
ONESIGNAL_APP_ID=your_onesignal_app_id
RESEND_API_KEY=your_resend_api_key

########################################
# FEATURES
########################################

ENABLE_ANALYTICS=false
ENABLE_COPY_TRADING=true
ENABLE_NOTIFICATIONS=true

########################################
# LOGGING
########################################

LOG_LEVEL=debug
